# Salin file ini menjadi .env (untuk dev lokal dengan `vercel dev`)
# Ambil connection string dari Neon Console -> Project -> Connection Details
# Gunakan yang "Pooled connection" (mengandung "-pooler" di hostname)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
